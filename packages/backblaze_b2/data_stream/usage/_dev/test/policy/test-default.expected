inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            name: backblaze_b2
      name: test-default-backblaze_b2
      streams:
        - access_key_id: "0040000000000000000000001"
          bucket_list_interval: 1h
          bucket_list_prefix: "2026"
          data_stream:
            dataset: backblaze_b2.usage
          default_region: us-west-004
          endpoint: https://s3.us-west-004.backblazeb2.com
          non_aws_bucket_name: b2-reports-0123456789ab
          number_of_workers: 1
          publisher_pipeline.disable_host: true
          region: us-west-004
          secret_access_key: ${SECRET_0}
          tags:
            - forwarded
            - backblaze_b2-usage
      type: aws-s3
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-backblaze_b2.usage-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references:
    - {}
